rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'trixz.ya2@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation helper for Product
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'images', 'stock']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category in ['suits', 'shirts', 'accessories', 'shoes'] &&
             data.images is list && data.images.size() > 0 && data.images.size() <= 10 &&
             data.stock is number && data.stock >= 0 &&
             (data.get('description', '') is string) &&
             (data.get('sizes', []) is list) &&
             (data.get('colors', []) is list);
    }

    // Products collection
    match /products/{productId} {
      allow read: if true; // Catalog is public
      
      allow create: if isAdmin() && 
                    isValidId(productId) &&
                    isValidProduct(incoming()) &&
                    incoming().createdAt == request.time;
                    
      allow update: if isAdmin() &&
                    isValidId(productId) &&
                    isValidProduct(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'name', 'description', 'price', 'category', 
                      'images', 'sizes', 'colors', 'features', 'stock', 'updatedAt'
                    ]) &&
                    incoming().updatedAt == request.time;
                    
      allow delete: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && 
                    incoming().uid == userId &&
                    incoming().email == request.auth.token.email;
      allow update: if isSignedIn() && request.auth.uid == userId &&
                    incoming().uid == userId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'roles']); // User can only update name
      allow delete: if isAdmin();
    }
    
    // Admins collection (protected)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable via console or service account for safety
    }
  }
}
